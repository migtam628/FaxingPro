# Copy to deployment/telnyx/.env, fill locally; NEVER commit real secrets
FAXINGPRO_HTTP_PORT=8092
DB_PASSWORD=REPLACE_WITH_FIRST_64_CHARACTER_HEX_SECRET
API_TOKEN=REPLACE_WITH_SECOND_64_CHARACTER_HEX_SECRET
MEDIA_SIGNING_SECRET=REPLACE_WITH_THIRD_64_CHARACTER_HEX_SECRET
STORAGE_ENCRYPTION_KEY=REPLACE_WITH_FOURTH_64_CHARACTER_HEX_SECRET
TELNYX_API_KEY=
TELNYX_FAX_APP_ID=
TELNYX_FROM_NUMBER=
TELNYX_PUBLIC_KEY=
TELNYX_PUBLIC_BASE_URL=https://fax.example.com
SEND_ENABLED=false
TEST_DESTINATION=

# Optional browser-session TOTP challenge; leave blank by default.
# The legacy master API_TOKEN bearer API is NOT MFA-protected by this option.
OPERATOR_TOTP_SECRET=

# Optional hardened mode: disabled rejects master API_TOKEN as a Bearer credential on /api/*.
# Only activate AFTER OPERATOR_TOTP_SECRET is configured, tested and recovered securely.
# Default legacy preserves older scripts and is NOT fully MFA-protected.
OPERATOR_BEARER_MODE=legacy
