# Copy to .env and generate a long random secret:
# openssl rand -hex 32
API_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Web proxy exposes the API under the same browser origin.
# For direct development or desktop connectivity, list trusted UI origins.
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
FAX_TRANSPORT=disabled
